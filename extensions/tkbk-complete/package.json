{
  "name": "tkbk-complete",
  "displayName": "TKBK Tab: автодополнение кода",
  "description": "Подсказки кода по Tab через шлюз TKBK: быстрая модель из каталога TKBK, один ключ cr_… на всё.",
  "version": "0.1.0",
  "publisher": "tkbk-online",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.101.0" },
  "categories": ["Programming Languages", "Machine Learning", "Other"],
  "repository": { "type": "git", "url": "https://github.com/tkbk-online/tkbk-ide" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      { "command": "tkbk.completion.setApiKey", "title": "Tab-автодополнение: указать ключ TKBK", "category": "TKBK IDE" },
      { "command": "tkbk.completion.clearApiKey", "title": "Tab-автодополнение: удалить сохранённый ключ", "category": "TKBK IDE" },
      { "command": "tkbk.completion.toggle", "title": "Tab-автодополнение: включить/выключить", "category": "TKBK IDE" },
      { "command": "tkbk.completion.selectModel", "title": "Tab-автодополнение: выбрать модель", "category": "TKBK IDE" },
      { "command": "tkbk.completion.menu", "title": "Tab-автодополнение: меню", "category": "TKBK IDE" },
      { "command": "tkbk.completion.showLog", "title": "Tab-автодополнение: показать журнал", "category": "TKBK IDE" }
    ],
    "configuration": {
      "title": "TKBK Tab (автодополнение)",
      "properties": {
        "tkbk.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Показывать подсказки кода (серый текст, принимается клавишей Tab)."
        },
        "tkbk.completion.model": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "markdownDescription": "Модель из каталога TKBK для автодополнения. Нужна быстрая и дешёвая: `deepseek-v4-pro`, `glm-5.3`, `gpt-6.1-sol`. Список — команда «Tab-автодополнение: выбрать модель»."
        },
        "tkbk.completion.baseUrl": {
          "type": "string",
          "default": "https://api.tkbk.online/v1",
          "description": "Адрес шлюза TKBK (OpenAI- и Anthropic-совместимый)."
        },
        "tkbk.completion.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Пауза после ввода перед запросом подсказки, мс."
        },
        "tkbk.completion.maxTokens": {
          "type": "number",
          "default": 160,
          "minimum": 16,
          "maximum": 1024,
          "description": "Максимальная длина подсказки в токенах."
        },
        "tkbk.completion.multiline": {
          "type": "string",
          "enum": ["auto", "always", "never"],
          "default": "auto",
          "enumDescriptions": [
            "Несколько строк, когда курсор в начале новой строки или после открывающей скобки",
            "Всегда разрешать несколько строк",
            "Только до конца текущей строки"
          ],
          "description": "Когда подсказка может занимать несколько строк."
        },
        "tkbk.completion.contextChars": {
          "type": "number",
          "default": 6000,
          "minimum": 500,
          "maximum": 60000,
          "description": "Сколько символов до курсора отправлять как контекст (после курсора — четверть от этого)."
        },
        "tkbk.completion.disabledLanguages": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["plaintext", "log", "dotenv", "ini", "properties", "scminput"],
          "description": "Языки, для которых подсказки не показываются."
        },
        "tkbk.completion.timeoutMs": {
          "type": "number",
          "default": 8000,
          "description": "Таймаут запроса к шлюзу, мс."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "tkbk.completion.setApiKey" },
        { "command": "tkbk.completion.clearApiKey" },
        { "command": "tkbk.completion.toggle" },
        { "command": "tkbk.completion.selectModel" },
        { "command": "tkbk.completion.menu" },
        { "command": "tkbk.completion.showLog" }
      ]
    }
  }
}
